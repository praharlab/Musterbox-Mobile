# Copy to .env (dev), .env.staging, .env.production. Never commit real values.
APP_ENV=development
# REST base URL, WITH trailing slash. Backend serves REST on port 3000 with no /api prefix.
API_BASE_URL=http://10.0.2.2:3000/
# Base used to build public file URLs (the backend's APIURL). Usually the same as API_BASE_URL.
FILE_BASE_URL=http://10.0.2.2:3000/
# socket.io server (separate port 3210). Reserved for Phase 2 chat.
SOCKET_URL=http://10.0.2.2:3210
# Request timeouts (ms)
API_TIMEOUT_MS=30000
API_UPLOAD_TIMEOUT_MS=60000
# Feature flags ("true"/"false"). See docs/BACKEND_GAPS.md before enabling in production.
# Forgot password via SMS OTP. Backend /auth/v1/reset does not verify the OTP (GAP P0-1).
FEATURE_FORGOT_PASSWORD=false
# Approve/reject from mobile. Backend does not check the caller is the approver (GAP P0-10).
FEATURE_APPROVAL_DECISIONS=true
# Submit attendance regularization. Payload builder must be verified against the web client.
FEATURE_REGULARIZATION_SUBMIT=true
